** sch_path: /foss/designs/test/testbench/bandgap_bufor_core_tran_tb.sch
**.subckt bandgap_bufor_core_tran_tb
VGD gd 0 0
VSUB gd sub! 0
VP18 vp_18 gd 'xvp_18'
C1 out gd 30n
x1 vp_33 vref_res vref_sb bias out gd sel sel_n bandgap_buf_core
x3 vp_33 vref_res gd bias bandgap_res_top
x4 vp_18 vref_sb gd bandgap_selfbias_top
VP33 vp_33 gd 'xvp_33'
VSEL sel gd PWL(0 0 '20u' 0 '20u+1n' 'xvp_33' '60u' 'xvp_33' '60u+1n' '0')
ESEL_N sel_n gd vp_33 sel 1
R1 out gd 500
**** begin user architecture code


.lib cornerMOShv.lib mos_tt
.lib cornerRES.lib res_typ
.lib cornerPNP.lib typ

.include cap_mfringe.lib

.param xvp_33=3.3
.param xvp_18=1.8
.param xtemp=25

.save v(vp_18)
.save v(vp_33)
.save v(vref_res)
.save v(vref_sb)
.save v(bias)
.save v(sel)
.save v(out)
.save v(x1.vg)
.save v(x1.vbuf)

.temp 'xtemp'

.options rshunt=1G

.tran 10n 100u


**** end user architecture code
**.ends

