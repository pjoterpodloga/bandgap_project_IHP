** sch_path: /foss/designs/test/testbench/bandgap_bufor_dc_tb.sch
**.subckt bandgap_bufor_dc_tb
EINP inp net2 in gd 0.5
EINM inm net2 in gd -0.5
C1 out gd xcload
VGD gd 0 0
VP vp gd xvp
VSUB gd sub! 0
VIN in gd DC xvid
VCM net2 gd '0.7'
x2 vp net3 gd net4 net5 const_gm_bias
* noconn #net4
* noconn #net5
Viopamp vp net1 0
.save i(viopamp)
XM1 bias bias gd gd sg13_hv_nmos w=1.2u l=0.9u ng=1 m=2
x1 net1 inp inm out bias gd opamp_folded_pmos_buf
Vibias net3 bias 0
.save i(vibias)
**** begin user architecture code


.lib cornerMOShv.lib mos_tt
.lib cornerRES.lib res_typ

.param xvp=3.3
.param xvid=0
.param xcload=1p

.param xtemp=25

.save v(in)
.save v(out)
.save i(vibias)
.save v(vp)
.save i(viopamp)

.temp 'xtemp'
.dc VIN -10m 10m 10u

.option rshunt=1e12


**** end user architecture code
**.ends

