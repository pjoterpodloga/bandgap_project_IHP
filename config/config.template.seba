# Example of configuration for SEBA file
NAME           <TB_NAME>           # Name of testbench, temporary files will be placed in tmp/simulations
                                   # report will be created under this name
CONTROL        <control.spice>     # Control file that will be inserted into final SPICE file
TESTBENCH      <testbench.sch>     # xschem schematic of testbench that will be inserted as netlist into final SPICE file
CORNERS        <corner.gen>        # Corner generation file
SCRIPT         <script.py>         # Script for measurment and plot generation
MEAS           <measurment.meas>   # Measurment file for report generation,
                                   # measurment generated by script will be merged with specification defined by measurment flie
PLOT           <plot.plt>          # Plot file for report genration
                                   # plots generated by script will be merged with plot defined in plot file
EXTRACTION     <layout.pex.spice>  # Optional argument for post-layout simulation, this file will be replace subckt, with corresponding name, in final SPICE file
